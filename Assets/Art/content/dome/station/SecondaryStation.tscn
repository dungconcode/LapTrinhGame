[sub_resource type="Shader" id="65"]
code = "shader_type canvas_item;

uniform sampler2D palette;
uniform vec4 watercolor : source_color;
uniform float water_strength = 0.0;
const float start_r = 0.5 / float(32);
const float start_b = 0.5 / float(12);

void fragment() {
	vec4 input = texture(TEXTURE, UV);
	input.r = mix(input.r, input.r - 0.05, water_strength);
	vec3 output = texture(palette, vec2(start_r + input.r, start_b+input.b)).rgb;
	vec3 water_output = texture(palette, vec2(start_r + watercolor.r, start_b+watercolor.b)).rgb;
	COLOR.rgb = mix(output, water_output, water_strength);
	COLOR.a = input.a;
}"

